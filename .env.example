# AI Intelligence Hub - Local Environment Configuration
# 100% Free & Open Source

ENVIRONMENT=development
PROJECT_NAME="AI Intelligence Hub"
SECRET_KEY="ai-hub-super-secret-local-key-2025-secure-token-dev"

# Database (Leave blank to use zero-config local SQLite in ./data/ai_hub.db)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/ai_hub
# SYNC_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/ai_hub

# Local Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# MLOps & Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# MLFLOW_TRACKING_URI=http://localhost:5000
